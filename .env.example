# Copy to .env and adjust for your machine / environment.
#   copy .env.example .env

# ── SQL Server (Windows Trusted Connection) ──────────────────────────
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=QA_Fleet_DB
DB_DRIVER=ODBC Driver 17 for SQL Server
# DIM: received (total) + in-use (IsActive=1)
DB_TABLE=[DIM].[Vehicle]
# FACT: credited / withdrawn vehicles
DB_WITHDRAWN_TABLE=[FACT].[SigningReturnVehicle]
# FACT: allocated / transferred vehicles
DB_ALLOCATED_TABLE=[FACT].[VehicleFlow]
# Warehouse Environment column value used in every query
DB_ENVIRONMENT=מבצעי
# Optional: folder of *.xlsx files imported by `python db.py`
# Filenames must be [Schema].[Table].xlsx
DB_CSV_PATH=data/raw

# ── Portal / dashboard URLs ──────────────────────────────────────────
LOGIN_URL=https://portal-agamim.example.net/application/<app-id>?environment=<env>
DASHBOARD_URL=https://portal-agamim.example.net/application/<app-id>?environment=<env>
DASHBOARD_SEARCH_TERM=שליטה בניוד
PORTAL_ALL_PRODUCTS_LABEL=למעבר לקטלוג המוצרים
PORTAL_CATALOG_URL=https://portal-agamim.example.net/catalog?environment=<env>

# ── Browser / auth ───────────────────────────────────────────────────
# Playwright storage state (gitignored). Created on first manual login.
AUTH_FILE=auth_state.json
HEADLESS=true
# true  = interactive SSO / MFA once per machine, then reuse AUTH_FILE
# false = reuse AUTH_FILE only (required shape for unattended / CI runs)
MANUAL_LOGIN=true
DEFAULT_TIMEOUT=30000
# Max ms from authenticated reload → total KPI visible (smoke SLA test)
DASHBOARD_LOAD_SLA_MS=30000
# Progressive waits (ms), capped by DEFAULT_TIMEOUT. First step = fast path.
TIMEOUT_STEPS_MS=3000,8000,20000
# Optional KPI change waits (ms) — keep short; do not equal DEFAULT_TIMEOUT
KPI_OPTIONAL_WAIT_MS=2500
# Playwright tracing (screenshots/snapshots) — expensive; enable for flake debug.
# Traces are saved on failure only.
ENABLE_TRACING=false
# Full-run browser video (.webm), including passing tests. Also: pytest --video
# Written to test-results/videos/run_<timestamp>/ so previous runs are kept.
ENABLE_VIDEO=false
SLOW_MO=0
PAUSE_ON_FAILURE=false
