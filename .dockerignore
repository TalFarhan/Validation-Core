# Keep the build context small and never bake secrets/artifacts into the image.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# Local secrets / saved sessions (mount at runtime instead of copying in).
.env
auth_state.json

# Test artifacts are produced inside the container and exported via a volume.
results/
test-results/
allure-results/
allure-report/
report.html

# Editor / OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# Docker files themselves.
Dockerfile
docker-compose.yml
.dockerignore

# Tooling caches that must not enter the image context.
node_modules/
coverage/
